# Copy to .env and fill in.

# --- LLM provider ---
# "openai" or "anthropic". Every agent goes through one function, so this is
# the only switch needed.
LLM_PROVIDER=openai

# --- OpenAI (when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# Must support structured outputs, which all seven agents depend on.
OPENAI_MODEL=gpt-4o
# Only reasoning models accept this. Leave blank for gpt-4o and similar —
# sending it to a model that doesn't support it is a 400.
OPENAI_REASONING_EFFORT=
# Hard ceiling on completion tokens. gpt-4o allows 16384; exceeding a model's
# limit is a 400, not a truncation. Raise it for a model that supports more.
OPENAI_MAX_OUTPUT_TOKENS=16384

# --- Anthropic (when LLM_PROVIDER=anthropic) ---
# Leave the key blank if you authenticate with `ant auth login` instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Database ---
# Dev default is SQLite; swap for PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/career_copilot
DATABASE_URL=sqlite:///./career_copilot.db

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Access control ---
# Accounts replaced the single shared password. Register the first one through
# the app, or adopt a pre-existing profile with:
#   python scripts/set_password.py --list
#   python scripts/set_password.py you@example.com
#
# Whether a recruiter's organization must be verified before it can post roles
# or view candidates. Leave true anywhere public: an unverified recruiter
# posting a fake role is how students' contact details get harvested.
REQUIRE_ORG_VERIFICATION=true

# Legacy, unused. Kept only so an existing deployment doesn't fail to start.
APP_PASSWORD=
# Signs the session cookie. Must be stable across restarts (or everyone is
# logged out on every deploy) and must be secret (or the cookie is forgeable).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
SESSION_DAYS=30
# Send the session cookie only over HTTPS. Leave false for plain-http
# localhost; set true anywhere real.
COOKIE_SECURE=false

# --- Rate limits (per client IP, per window) ---
# AI routes spend money on every call, so they cap far below ordinary reads.
RATE_LIMIT_AI_PER_HOUR=40
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_HOUR=10

# --- Ingestion ---
# Path to the Tesseract binary. Only needed for screenshot/image ingestion.
# Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
MAX_UPLOAD_MB=15
